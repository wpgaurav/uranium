{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1344px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "paper", "name": "Paper", "color": "#FAFBF8" },
				{ "slug": "surface", "name": "Surface", "color": "#F0F1EB" },
				{ "slug": "ink", "name": "Ink", "color": "#181A17" },
				{ "slug": "muted", "name": "Muted", "color": "#5B6056" },
				{ "slug": "signal", "name": "Signal", "color": "#FFCC00" },
				{ "slug": "on-signal", "name": "On signal", "color": "#181A17" },
				{ "slug": "band", "name": "Band", "color": "#181B17" },
				{ "slug": "on-band", "name": "On band", "color": "#F7F8F0" }
			]
		},
		"custom": {
			"color": {
				"signal-hover": "#F0C900",
				"signal-text": "#FFCC00",
				"on-band-muted": "#BCC3B3",
				"control": "#7E8279",
				"plate": "#F0F1EB",
				"plate-ink": "#181A17",
				"focus": "#375FA2",
				"error": "#B32822",
				"success": "#2E6B3A",
				"info": "#375FA2"
			},
			"radius": "2px"
		},
		"shadow": {
			"defaultPresets": false
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "8px" },
				{ "slug": "20", "name": "2", "size": "12px" },
				{ "slug": "30", "name": "3", "size": "16px" },
				{ "slug": "40", "name": "4", "size": "24px" },
				{ "slug": "50", "name": "5", "size": "32px" },
				{ "slug": "60", "name": "6", "size": "48px" },
				{ "slug": "70", "name": "7", "size": "64px" },
				{ "slug": "80", "name": "Section", "size": "clamp(3.5rem, 6.2vw, 5.5rem)" }
			],
			"units": [ "px", "rem", "em", "%", "vw", "vh", "ch" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "IBM Plex Sans",
					"fontFamily": "\"IBM Plex Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "normal",
							"fontWeight": "100 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "normal",
							"fontWeight": "100 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "italic",
							"fontWeight": "100 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-latin-wght-italic.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "italic",
							"fontWeight": "100 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-latin-ext-wght-italic.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "condensed",
					"name": "IBM Plex Sans Condensed",
					"fontFamily": "\"IBM Plex Sans Condensed\", \"Arial Narrow\", \"Roboto Condensed\", ui-sans-serif, sans-serif",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans Condensed",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-condensed-latin-600-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "IBM Plex Sans Condensed",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-condensed-latin-ext-600-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "IBM Plex Sans Condensed",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-condensed-latin-700-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "IBM Plex Sans Condensed",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-sans-condensed-latin-ext-700-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-mono-latin-400-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-mono-latin-ext-400-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "micro", "name": "Micro", "size": "0.6875rem" },
				{ "slug": "label", "name": "Label", "size": "0.75rem" },
				{ "slug": "fine", "name": "Fine", "size": "0.8125rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "body", "name": "Body", "size": "1rem" },
				{ "slug": "intro", "name": "Intro", "size": "1.1875rem" },
				{ "slug": "lead", "name": "Lead", "size": "1.25rem" },
				{ "slug": "subhead", "name": "Subhead", "size": "1.375rem" },
				{ "slug": "title", "name": "Title", "size": "1.75rem" },
				{ "slug": "headline", "name": "Headline", "size": "clamp(2.25rem, 3.6vw, 3.7rem)" },
				{ "slug": "statement", "name": "Statement", "size": "clamp(2.5rem, 4.5vw, 4.75rem)" },
				{ "slug": "page-title", "name": "Page title", "size": "clamp(3rem, 6.4vw, 6.5rem)" },
				{ "slug": "display", "name": "Display", "size": "clamp(2.6rem, 5.4vw, 5.3rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 3.2vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 3.2vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|body",
			"fontWeight": "400",
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|condensed",
					"fontWeight": "600",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": { "fontSize": "var:preset|font-size|page-title", "lineHeight": "1.03" }
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|headline", "lineHeight": "1.1" }
			},
			"h3": {
				"typography": { "fontSize": "var:preset|font-size|title", "lineHeight": "1.2" }
			},
			"h4": {
				"typography": { "fontSize": "var:preset|font-size|subhead", "lineHeight": "1.25" }
			},
			"h5": {
				"typography": { "fontSize": "var:preset|font-size|lead", "lineHeight": "1.3" }
			},
			"h6": {
				"typography": { "fontSize": "var:preset|font-size|body", "lineHeight": "1.4" }
			},
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "none" }
				}
			},
			"button": {
				"border": {
					"color": "var:preset|color|signal",
					"radius": "var(--wp--custom--radius)",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|signal",
					"text": "var:preset|color|on-signal"
				},
				"spacing": {
					"padding": { "top": "15px", "right": "16px", "bottom": "15px", "left": "22px" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "1rem",
					"fontWeight": "500",
					"lineHeight": "1.5",
					"textDecoration": "none"
				},
				":hover": {
					"border": { "color": "var(--wp--custom--color--signal-hover)" },
					"color": {
						"background": "var(--wp--custom--color--signal-hover)",
						"text": "var:preset|color|on-signal"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|fine" }
			}
		},
		"blocks": {
			"core/code": {
				"color": { "background": "var:preset|color|surface" },
				"spacing": { "padding": { "top": "16px", "right": "20px", "bottom": "16px", "left": "20px" } },
				"typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|small" }
			},
			"core/preformatted": {
				"typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|small" }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem" }
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|condensed",
					"fontSize": "1.5rem",
					"fontWeight": "600",
					"lineHeight": "1",
					"textTransform": "uppercase"
				}
			},
			"core/quote": {
				"typography": { "fontFamily": "var:preset|font-family|condensed", "fontSize": "var:preset|font-size|title", "fontWeight": "600", "lineHeight": "1.25" }
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var:preset|font-family|condensed", "fontSize": "var:preset|font-size|headline", "fontWeight": "600", "lineHeight": "1.1" }
			}
		}
	},
	"templateParts": [
		{ "area": "header", "name": "header", "title": "Header" },
		{ "area": "footer", "name": "footer", "title": "Footer" }
	]
}
